# =========================================================
# GRADit! ERP - Supabase Backend Configuration
# =========================================================

# 1. Project URL (from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Publishable / Anon Key (Safe for Client & Server)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. (Optional) Service Role Secret Key (Server-Side ONLY - Do NOT expose to client)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
